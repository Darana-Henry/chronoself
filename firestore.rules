rules_version = '2';

// Only the owner's account can read or write anything. __OWNER_UID__ is
// replaced by scripts/inject.js (OWNER_UID env var) when building build/firestore.rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && uid == '__OWNER_UID__';
    }
  }
}
